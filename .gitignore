# Build outputs / cache
/.ruff_cache

# Mise-managed project state
/.venv
/.mise
# .agents holds local agent state, but committed agent skills live under
# .agents/skills/ (OpenCode discovers them alongside .claude/skills).
/.agents/*
!/.agents/skills/

# Wordlists symlink (created by mise run setup-local -> .mise/sources/)
/wordlists

# Claude's temp directory
/tmp

# Analysis artifacts
/artifacts

# Samples under analysis (installers, firmware, dumps)
/inputs

# Things to be reverse engineered
*.apk
*.xapk
*.sys
*.cat
*.exe
*.so
*.uf2
*.quark.log
